+            },
+        });
+        launch.cancel_document((11, 23));
+        assert!(cancellation.is_cancelled());
+        assert!(launch.requests.is_empty());
+
+        let next = pool.spawn(|| {}, |_| Ok::<_, String>(9)).unwrap();
