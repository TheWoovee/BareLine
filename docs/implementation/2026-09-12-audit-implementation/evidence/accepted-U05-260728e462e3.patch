 impl crate::EditorSurface {
+    /// Enqueue one input against an idle surface and retain its exact actor
+    /// terminal. Refusing an already-busy surface keeps the receipt attached to
+    /// this input rather than an older queued edit.
+    pub fn enqueue_tracked(&mut self, input: crate::Input) -> Result<TrackedEditReceipt, String> {
+        if self.busy() {
+            return Err("Editor is busy; tracked input was not queued".into());
+        }
+        let receipt = TrackedEditReceipt::new(self.snapshot.identity_token());
+        self.enqueue(input);
+        if let Some(pending) = self.pending.as_mut() {
+            pending.tracked = Some(TrackedEditCompletion(receipt.clone()));
+        } else if let Some(error) = &self.error {
+            return Err(error.clone());
+        } else {
+            receipt.complete_once(Ok(self.snapshot.revision));
+        }
+        Ok(receipt)
+    }
