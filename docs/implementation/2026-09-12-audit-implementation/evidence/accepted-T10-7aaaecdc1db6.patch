+            options.open(path).ok().map(Mutex::new)
+        })
+    });
+    if let Some(sink) = sink
+        && let Ok(mut file) = sink.lock()
+        && file.write_all(event.as_bytes()).and_then(|()| file.flush()).is_ok()
