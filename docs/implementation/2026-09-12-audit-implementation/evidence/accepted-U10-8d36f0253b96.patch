+    fn font_size(controller: &SettingsController, scope: Scope) -> f64 {
+        let editor = controller.editor_for_scope(scope).unwrap();
+        config::resolve(&editor.document, None, false, None)
+            .values
+            .editor_font_size_pt
+    }
