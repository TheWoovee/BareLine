+    /// Refresh a linked view only after the publishing peer has settled.
+    pub fn refresh_linked_peer(&mut self, peer: &EditorSurface) -> bool {
+        if peer.busy() || !self.snapshot.same_document(&peer.snapshot) {
+            return false;
+        }
+        self.refresh_peer(peer.snapshot())
+    }
+    /// Move the shared document-history cursor to the view receiving input.
+    /// The vectors retain their allocation and move in constant time.
+    pub fn take_peer_history(&mut self, peer: &mut EditorSurface) -> bool {
+        if self.busy()
+            || peer.busy()
+            || !self.snapshot.same_document(&peer.snapshot)
+            || self.snapshot.revision != peer.snapshot.revision
+        {
+            return false;
+        }
+        if peer.undo_selection.is_empty() && peer.redo_selection.is_empty() {
+            return true;
+        }
+        self.undo_selection = std::mem::take(&mut peer.undo_selection);
+        self.redo_selection = std::mem::take(&mut peer.redo_selection);
+        self.history_boundary = peer.history_boundary;
+        true
+    }
