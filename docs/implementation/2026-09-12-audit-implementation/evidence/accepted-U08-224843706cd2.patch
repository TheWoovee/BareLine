+                assert!(std::time::Instant::now() < deadline);
+                std::thread::yield_now();
+            }
+        };
+        source.enqueue(Input::Insert("base".into()));
+        drain(&mut source);
+        let mut target = source.clone_view();
+        let target_revision = target.snapshot.revision;
