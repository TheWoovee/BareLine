+        source.pump();
+        assert!(source.busy());
+        assert!(!target.refresh_linked_peer(&source));
+        assert_eq!(target.snapshot.revision, target_revision);
+        assert_eq!(target.snapshot.read(TextOffset(0)..TextOffset(4), 4).unwrap(), "base");
