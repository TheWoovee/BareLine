+                        if let Some((old, _)) = self.watch.remote_follow.insert(path, (grant, fs)) {
+                            old.revoke();
+                        }
+                    }
+                    Err(error) => {
+                        grant.revoke();
+                        if let Some(w) = &mut self.workspace {
+                            w.message = Some(error);
+                        }
+                    }
+                }
+                return;
+            }
+        }
