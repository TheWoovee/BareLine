+impl ResidentRecovery {
+    /// Delete every journal directory this document owns. Called when the document is
+    /// closed cleanly or its changes are discarded: there is nothing left to recover.
+    pub fn discard_now(&mut self) {
+        self.cancellation.cancel();
+        // Let in-flight checkpoint/retirement workers finish and release their
+        // file handles first: deleting a directory whose files are still open
+        // fails on Windows, which previously left a retired generation behind.
+        if let Some(receiver) = self.pending.take() {
+            let _ = receiver.recv_timeout(Duration::from_secs(2));
+        }
+        if let Some(receiver) = self.retirement.take() {
+            let _ = receiver.recv_timeout(Duration::from_secs(2));
+        }
+        let mut paths = std::mem::take(&mut self.retire_paths);
+        for recovery in std::mem::take(&mut self.previous)
+            .into_iter()
+            .chain(self.current.take())
+        {
+            paths.push(recovery.directory().to_path_buf());
+        }
+        for generation in 0..2 {
+            let path = self.root.join(format!("{}-g{}", self.slot, generation));
+            if !paths.contains(&path) && path.exists() {
+                paths.push(path);
+            }
+        }
+        for path in paths {
+            // A worker may still be closing its last handle; retry briefly rather
+            // than silently abandoning plaintext recovery data.
+            for attempt in 0..=20 {
+                if crate::paged_recovery::purge_directory(&path, self.platform.as_ref()).is_ok() {
+                    break;
+                }
+                if attempt < 20 {
+                    std::thread::sleep(Duration::from_millis(25));
+                }
+            }
+        }
+        if let Ok(mut status) = self.status.lock() {
+            *status = Default::default();
+        }
+    }
+}
