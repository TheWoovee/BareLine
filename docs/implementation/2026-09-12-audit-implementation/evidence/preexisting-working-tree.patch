+    Busy,
+    Poisoned,
+    Changed,
+}
+impl std::fmt::Display for PagedError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            PagedError::Busy => f.write_str("Paged source is busy"),
+            PagedError::Poisoned => f.write_str("Paged source worker failed"),
+            PagedError::Changed => f.write_str("Paged source changed"),
+        }
+    }
+}
+impl From<PagedError> for String {
+    fn from(error: PagedError) -> String {
+        error.to_string()
