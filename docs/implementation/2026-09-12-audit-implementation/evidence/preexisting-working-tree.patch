+pub(crate) fn bounded_chunks(text: &str) -> impl Iterator<Item = (usize, &str)> {
+    let mut start = 0;
+    std::iter::from_fn(move || {
+        if start == text.len() {
+            return None;
+        }
+        let mut end = (start + 64 * 1024).min(text.len());
+        while !text.is_char_boundary(end) {
+            end -= 1;
+        }
+        let result = (start, &text[start..end]);
+        start = end;
+        Some(result)
+    })
 }
