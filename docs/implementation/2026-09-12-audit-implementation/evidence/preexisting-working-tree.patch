+/// Fade a gutter colour toward the editor background so estimated line numbers
+/// read as provisional while the line index is still being built (UX-04).
+fn estimated_gutter(
+    gutter: bareline_renderer::Color,
+    background: bareline_renderer::Color,
+) -> bareline_renderer::Color {
+    let mut result = 0;
+    for shift in [16, 8, 0] {
+        let a = (gutter.0 >> shift) & 255;
+        let b = (background.0 >> shift) & 255;
+        // A little over half-way toward the background: visible but clearly muted.
+        result |= ((a * 150 + b * 105 + 127) / 255) << shift;
+    }
+    bareline_renderer::Color(result)
+}
