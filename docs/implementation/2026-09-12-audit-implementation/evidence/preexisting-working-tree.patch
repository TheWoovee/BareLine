+pub(crate) fn rejected_range(text: &str, target: Encoding, base: usize) -> std::ops::Range<usize> {
+    let encoder = super::Encoder::new(target, false);
+    for (offset, scalar) in text.char_indices() {
+        let mut bytes = [0; 4];
