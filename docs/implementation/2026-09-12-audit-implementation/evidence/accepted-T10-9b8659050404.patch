+        if ($null -eq $failure -and $buildExit -ne 0) {
+            $failure = "Component build failed with exit $buildExit"
+        }
+    }
+
+    if ($null -eq $failure) {
+        $compileExit = Invoke-RetainedCommand -Name 'host-test-compile' -TimeoutSeconds 900 -Command @(
