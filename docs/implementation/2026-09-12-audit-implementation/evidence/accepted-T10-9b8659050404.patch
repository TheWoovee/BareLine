-} finally { Pop-Location }
+    $targetExit = Invoke-RetainedCommand -Name 'wasi-target' -TimeoutSeconds 300 -Command @(
+        'rustup', 'target', 'add', 'wasm32-wasip2'
+    )
+    if ($targetExit -ne 0) {
