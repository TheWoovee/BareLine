+struct QaCommandTrace {
+    file: Option<File>,
+    emitted: u8,
+    seen_transitions: Vec<(u64, &'static str)>,
+}
+impl QaCommandTrace {
+    const LIMIT: u8 = 24;
+    #[cfg(test)]
+    fn disabled() -> Self {
+        Self {
+            file: None,
+            emitted: 0,
+            seen_transitions: Vec::new(),
+        }
+    }
+    fn from_environment() -> Self {
+        let file = std::env::var_os("BARELINE_QA_COMMAND_TRACE")
+            .map(PathBuf::from)
+            .and_then(|path| {
+                if let Some(parent) = path.parent().filter(|parent| !parent.as_os_str().is_empty()) {
+                    std::fs::create_dir_all(parent).ok()?;
+                }
+                OpenOptions::new()
+                    .create(true)
+                    .write(true)
+                    .truncate(true)
+                    .open(path)
+                    .ok()
+            });
+        Self {
+            file,
+            emitted: 0,
+            seen_transitions: Vec::new(),
+        }
+    }
+    fn record(
+        &mut self,
+        ticket: u64,
+        stage: &'static str,
+        detail: &'static str,
+        command_id: usize,
+        hwnd: isize,
+        code: i32,
+    ) {
+        if self.emitted >= Self::LIMIT {
+            return;
+        }
+        let Some(file) = &mut self.file else { return };
+        let _ = writeln!(
+            file,
+            "{{\"event\":\"qa_close_command\",\"ticket\":{ticket},\"stage\":\"{stage}\",\"detail\":\"{detail}\",\"command_id\":{command_id},\"hwnd\":{hwnd},\"code\":{code}}}"
+        );
+        let _ = file.flush();
+        self.emitted += 1;
+    }
+    fn transition(&mut self, ticket: u64, stage: &'static str, detail: &'static str) {
+        if self.file.is_none() || self.emitted >= Self::LIMIT || self.seen_transitions.contains(&(ticket, stage)) {
+            return;
+        }
+        self.seen_transitions.push((ticket, stage));
+        self.record(ticket, stage, detail, 0, 0, 0);
+    }
+}
