+            bareline_file_io::recovery_retirement::DiscardPoll::Durable => {
+                if Self::exit_discard_still_current(workspace, consents) {
+                    true
+                } else {
+                    Self::cancel_exit_discard(workspace, consents);
+                    false
+                }
