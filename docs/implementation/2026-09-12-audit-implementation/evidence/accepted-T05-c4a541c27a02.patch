+    #[derive(Default)]
+    struct WorkerGate {
+        state: Mutex<WorkerGateState>,
+        wake: Condvar,
+    }
+    impl WorkerGate {
+        fn enter_and_wait(&self) -> std::io::Result<()> {
+            let deadline = Instant::now() + Duration::from_secs(10);
+            let mut state = self.state.lock().unwrap();
+            state.entered = true;
+            self.wake.notify_all();
+            while !state.released {
+                let remaining = deadline.saturating_duration_since(Instant::now());
+                if remaining.is_zero() {
+                    return Err(std::io::Error::new(
+                        std::io::ErrorKind::TimedOut,
+                        "test worker gate timed out",
+                    ));
+                }
+                let (next, timeout) = self.wake.wait_timeout(state, remaining).unwrap();
+                state = next;
+                if timeout.timed_out() && !state.released {
+                    return Err(std::io::Error::new(
+                        std::io::ErrorKind::TimedOut,
+                        "test worker gate timed out",
+                    ));
+                }
+            }
+            Ok(())
+        }
+        fn wait_entered(&self) -> std::io::Result<()> {
+            let deadline = Instant::now() + Duration::from_secs(10);
+            let mut state = self.state.lock().unwrap();
+            while !state.entered {
+                let remaining = deadline.saturating_duration_since(Instant::now());
+                if remaining.is_zero() {
+                    return Err(std::io::Error::new(
+                        std::io::ErrorKind::TimedOut,
+                        "worker never reached gate",
+                    ));
+                }
+                let (next, timeout) = self.wake.wait_timeout(state, remaining).unwrap();
+                state = next;
+                if timeout.timed_out() && !state.entered {
+                    return Err(std::io::Error::new(
+                        std::io::ErrorKind::TimedOut,
+                        "worker never reached gate",
+                    ));
+                }
+            }
+            Ok(())
+        }
+        fn release(&self) {
+            self.state.lock().unwrap().released = true;
+            self.wake.notify_all();
+        }
+    }
