+struct JobWake(Option<Arc<dyn Fn() + Send + Sync>>);
+impl JobWake {
+    fn new(notify: Arc<dyn Fn() + Send + Sync>) -> Self {
+        Self(Some(notify))
+    }
+    fn finish(mut self) {
+        self.fire();
+    }
+    fn fire(&mut self) {
+        if let Some(notify) = self.0.take() {
+            let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| notify()));
+        }
+    }
