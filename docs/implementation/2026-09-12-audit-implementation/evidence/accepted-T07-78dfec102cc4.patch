+impl<T> JobCompletion<T> {
+    fn new(sender: SyncSender<Result<T, String>>, notify: Arc<dyn Fn() + Send + Sync>) -> Self {
+        Self {
+            sender: Some(sender),
+            wake: JobWake::new(notify),
+        }
+    }
+    fn complete(mut self, result: Result<T, String>) {
+        if let Some(sender) = self.sender.take() {
+            let _ = sender.try_send(result);
+        }
+        self.wake.fire();
+    }
+}
