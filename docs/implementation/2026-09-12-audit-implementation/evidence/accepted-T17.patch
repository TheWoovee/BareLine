+fn select_mode(requested: LaunchMode, portable_marker: bool) -> LaunchMode {
+    if matches!(requested, LaunchMode::Installed | LaunchMode::Diagnostic) && portable_marker {
+        LaunchMode::Portable
+    } else {
+        requested
+    }
+}
