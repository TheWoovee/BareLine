+#[cfg(test)]
+mod notification_shell_tests {
+    use super::accessibility::tests::headless_shell;
+    use bareline_app::workspace::Workspace;
+    use bareline_file_io::lifecycle::SaveConflict;
+    use std::{path::PathBuf, sync::Arc};
+
+    fn conflict(index: usize) -> SaveConflict {
+        SaveConflict {
+            target: Some(PathBuf::from(format!(r"C:\target-{index}.txt"))),
+            editor_version: PathBuf::from(format!(r"C:\retained\editor-{index}.txt")),
+            other_version: Some(PathBuf::from(format!(r"C:\retained\other-{index}.txt"))),
+            transaction: PathBuf::from(format!(r"C:\retained\transaction-{index}")),
+            state: bareline_platform::CommitState::Conflict,
+            verified: true,
+        }
+    }
+
+    #[test]
+    fn shell_sync_retains_more_than_visible_conflicts_without_replay_or_status_erasure() {
+        let mut shell = headless_shell();
+        let mut workspace =
+            Workspace::new(Arc::new(|| {}), Arc::new(bareline_platform_windows::WindowsFileSystem)).unwrap();
+        workspace.message = Some("Unrelated scoped status".into());
+        for index in 0..40 {
+            workspace.track_save_conflict(conflict(index));
+        }
+        shell.workspace = Some(workspace);
+        shell.sync_data_safety_notifications();
+        shell.toasts.draw(
+            &mut bareline_renderer_recording::RecordingBackend::default(),
+            1000.0,
+            800.0,
+            Default::default(),
+            &mut Vec::new(),
+        );
+        let first = shell.toasts.accessibility();
+        assert_eq!(first.len(), 6, "five notices plus the overflow route");
+        assert_eq!(
+            shell.workspace.as_ref().unwrap().message.as_deref(),
+            Some("Unrelated scoped status")
+        );
+        shell.sync_data_safety_notifications();
+        assert_eq!(shell.toasts.accessibility().len(), first.len());
+        assert!(
+            shell
+                .toasts
+                .accessibility()
+                .last()
+                .unwrap()
+                .details
+                .as_ref()
+                .unwrap()
+                .contains("transaction-0")
+        );
+    }
+}
