+    let mut source = std::fs::File::open(source)?;
+    let mut destination = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(destination)?;
+    let mut buffer = vec![0u8; 1024 * 1024];
+    loop {
+        cancellation.check()?;
+        let read = source.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        destination.write_all(&buffer[..read])?;
+    }
+    cancellation.check()?;
+    destination.sync_all()
