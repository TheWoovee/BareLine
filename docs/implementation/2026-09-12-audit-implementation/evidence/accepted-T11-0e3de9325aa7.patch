+        if ($LASTEXITCODE) { throw 'Signed update metadata fixtures failed' }
+        cargo test --locked -p bareline-extensions-protocol package::tests::signed_offline_install_tampering_freshness_and_remove
+        if ($LASTEXITCODE) { throw 'Local catalog install/update fixtures failed' }
+        cargo test --locked -p bareline-platform-windows update::stage_tests::local_fixture_transport_rejects_signature_policy_certificate_cancel_corruption_and_unavailable_runtime
+        if ($LASTEXITCODE) { throw 'Local update transport fixtures failed' }
+        cargo test --locked -p bareline release_without_owner_pins_cannot_open_or_install_catalog
+        if ($LASTEXITCODE) { throw 'Preview disabled-reason fixture failed' }
+        cargo build --locked --release -p bareline -p bareline-update-helper -p bareline-extension-host --features bareline/fixture-release,bareline-update-helper/fixture-release,bareline-extension-host/fixture-release
+        if ($LASTEXITCODE) { throw 'Fixture-configured executable build failed' }
+        $deliveryEvidence = Join-Path $fixtureEvidence 'connected-delivery'
+        $env:BARELINE_RELEASE_FIXTURE_PACKAGE_DIR = $componentPackages
+        $env:BARELINE_RELEASE_FIXTURE_RUNTIME = Join-Path $root 'target/release/bareline-extension-host.exe'
+        $env:BARELINE_RELEASE_FIXTURE_OUTPUT = $deliveryEvidence
+        cargo test --locked --release -p bareline --features bareline/fixture-release fixture_config_drives_catalog_runtime_and_three_component_install_with_tamper_rejection -- --nocapture
