+        if ($LASTEXITCODE) { throw 'Connected fixture resource inventory failed' }
+        & python scripts/release_config.py manifest --prepared $prepared --artifact "editor=$(Join-Path $root 'target/release/bareline.exe')" --artifact "helper=$(Join-Path $root 'target/release/bareline-update-helper.exe')" --artifact "runtime=$(Join-Path $root 'target/release/bareline-extension-host.exe')" --output (Join-Path $fixtureEvidence 'build-capabilities.json')
