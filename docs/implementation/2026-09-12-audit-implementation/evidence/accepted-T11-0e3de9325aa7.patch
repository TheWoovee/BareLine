+    "core_artifact_type": "bareline-executable-x64",
+    "runtime_artifact_type": "bareline-exthost-x64"
+  },
+  "features": { "updates": false, "extensions": false, "external_runtime": true },
+  "trust": {
+    "release_public_key": "",
+    "catalog_public_key": "",
+    "publisher": "",
+    "publisher_certificate_sha256": ""
+  },
+  "updates": {
+    "host": "",
+    "manifest_path": "",
+    "signature_path": "",
+    "artifact_path": "",
+    "metadata_version": 1,
+    "minimum_metadata_version": 1
+  }
+}
