 public static void Desktop() {
  var desktop=OpenInputDesktop(0,false,1);
  if(desktop==IntPtr.Zero)throw new Exception("Input desktop unavailable/locked; automation stopped");
  try {var name=new StringBuilder(256);int needed;
   if(!GetUserObjectInformationW(desktop,2,name,512,out needed) || !string.Equals(name.ToString(),"Default",StringComparison.OrdinalIgnoreCase))
    throw new Exception("Input desktop is not Default; automation stopped");
  } finally {CloseDesktop(desktop);}
