  var info=new HIGHCONTRAST();info.size=(uint)Marshal.SizeOf(info);
  if(!SystemParametersInfoW(0x42,info.size,ref info,0))throw new Exception("High contrast state unavailable");
  return (info.flags&1)!=0;
