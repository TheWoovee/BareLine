 [DllImport("user32.dll", CharSet=CharSet.Unicode)] static extern int GetClassNameW(IntPtr window,StringBuilder text,int size);
 public static string ClassName(IntPtr window) {var text=new StringBuilder(256);GetClassNameW(window,text,256);return text.ToString();}
 [DllImport("user32.dll")] static extern bool IsChild(IntPtr parent,IntPtr child);
 [DllImport("user32.dll", CharSet=CharSet.Unicode, SetLastError=true)] static extern IntPtr SendMessageTimeoutW(IntPtr window,uint message,UIntPtr w,StringBuilder text,uint flags,uint timeout,out UIntPtr result);
