function Hash-File([string]$path) {
 $stream=[IO.File]::Open($path,[IO.FileMode]::Open,[IO.FileAccess]::Read,([IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete))
 $sha=[Security.Cryptography.SHA256]::Create()
 try {([BitConverter]::ToString($sha.ComputeHash($stream))).Replace('-','').ToLowerInvariant()}
 finally {$stream.Dispose();$sha.Dispose()}
}
function Write-Json([string]$path,$value) {
 [IO.File]::WriteAllText($path,($value | ConvertTo-Json -Depth 16),[Text.UTF8Encoding]::new($false))
}
function Guard([IntPtr]$target=$script:window) {
 if($script:process.HasExited -or [JourneyInput]::Owner($target) -ne $script:process.Id){throw 'Owned process/window identity changed'}
 [JourneyInput]::Guard($target)
}
function Key([int]$key,[bool]$ctrl=$false,[bool]$shift=$false) {
 Guard
 [JourneyInput]::Key($script:window,[uint16]$key,$ctrl,$shift)
}
function Text([string]$text) {
 Guard
 [JourneyInput]::Text($script:window,$text)
}
function Elements([IntPtr]$target=$script:window) {
 if([JourneyInput]::Owner($target) -ne $script:process.Id){throw 'Foreign UIA root refused'}
 $root=[System.Windows.Automation.AutomationElement]::FromHandle($target)
 $walker=[System.Windows.Automation.TreeWalker]::ControlViewWalker
 $queue=[Collections.Generic.Queue[System.Windows.Automation.AutomationElement]]::new()
 $queue.Enqueue($root);$visited=0
 while($queue.Count -gt 0) {
  $element=$queue.Dequeue();$visited++
  if($visited -gt 512){throw 'UIA traversal exceeded 512 nodes'}
  # UIA may expose system decorations with no owning process under the host.
  # Never return them as action/observation targets. Do not traverse a subtree
  # attributed to another process; process-zero structural nodes are traversed.
  $owner=$element.Current.ProcessId
  if($owner -ne 0 -and $owner -ne $script:process.Id){continue}
  if($owner -eq $script:process.Id){,$element}
  $child=$walker.GetFirstChild($element)
  while($null -ne $child) {
   if($queue.Count+$visited -ge 512){throw 'UIA traversal exceeded 512 nodes'}
   $queue.Enqueue($child);$child=$walker.GetNextSibling($child)
  }
 }
}
function Record-Element($element,[bool]$valueOnly=$false) {
 $current=$element.Current
 $record=[ordered]@{name=$current.Name;automation_id=$current.AutomationId;runtime_id=@($element.GetRuntimeId());
  control_type=$current.ControlType.ProgrammaticName;focus=$current.HasKeyboardFocus;enabled=$current.IsEnabled;process_id=$current.ProcessId}
 if($current.ControlType -eq [System.Windows.Automation.ControlType]::Edit) {
  $pattern=$null
  if(-not $valueOnly -and $element.TryGetCurrentPattern([System.Windows.Automation.TextPattern]::Pattern,[ref]$pattern)) {
   $range=$pattern.DocumentRange
   if($null -eq $range){$record.text_available=$false;return [pscustomobject]$record}
   $record.text_available=$true;$record.text=$range.GetText(65537)
   if($record.text.Length -gt 65536){throw 'Text observation exceeded 65536 UTF-16 units'}
   $selection=$pattern.GetSelection()
   if($selection.Length -gt 128){throw 'Selection observation exceeded 128 ranges'}
   $record.selections=@(foreach($selectedRange in $selection) {
    $prefix=$range.Clone()
    $prefix.MoveEndpointByRange([System.Windows.Automation.Text.TextPatternRangeEndpoint]::End,$selectedRange,[System.Windows.Automation.Text.TextPatternRangeEndpoint]::Start)
    @{start_utf16=$prefix.GetText(65536).Length;text=$selectedRange.GetText(65536)}
   })
   if($selection.Length -eq 1) {
    $prefix=$range.Clone()
    $prefix.MoveEndpointByRange([System.Windows.Automation.Text.TextPatternRangeEndpoint]::End,$selection[0],[System.Windows.Automation.Text.TextPatternRangeEndpoint]::Start)
    $record.caret_utf16=$prefix.GetText(65536).Length;$record.selected_text=$selection[0].GetText(65536)
   }
  } elseif($element.TryGetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern,[ref]$pattern)) {
   $record.text=$pattern.Current.Value
   if($record.text.Length -gt 65536){throw 'Value observation exceeded 65536 UTF-16 units'}
  } elseif($valueOnly) {
   throw 'Expected field ValuePattern is unavailable'
  }
 }
 [pscustomobject]$record
}
function Snapshot([IntPtr]$target=$script:window) {
 @(Elements $target | ForEach-Object {Record-Element $_})
}
function Record([string]$stage,$details) {
 $script:records.Add([pscustomobject]@{stage=$stage;elapsed_ms=$script:timer.ElapsedMilliseconds;details=$details})
 # Persist checkpoints before the next native action, including when a later UIA
 # provider stalls and the outer supervisor must terminate this owned Job.
 Write-Json (Join-Path $script:scratch 'native-observations.json') ([ordered]@{binary_sha256=$script:request.binary_sha256;records=@($script:records.ToArray())})
}
function Editor {
 # AccessKit activation can publish the first provider after its host appears.
 # Poll only observations; never repeat input or choose an ambiguous provider.
 $deadline=[DateTime]::UtcNow.AddSeconds(5)
 do {
  Guard
  $matches=@(Elements | Where-Object {$_.Current.ControlType -eq [System.Windows.Automation.ControlType]::Edit -and $(if($script:editorPane){$_.Current.Name.StartsWith(('Pane '+$script:editorPane+', '))}else{$_.Current.Name -eq 'Editor'})})
  if($matches.Count -eq 1){return $matches[0]}
  if($matches.Count -gt 1){throw "Expected one Editor provider; found $($matches.Count)"}
  Start-Sleep -Milliseconds 50
 } while([DateTime]::UtcNow -lt $deadline)
 Record 'editor provider unavailable' (Snapshot)
 throw 'Editor provider was not published within the bounded discovery interval'
}
function Focus-Editor {
 Guard
 $editor=Editor
 if(-not $editor.Current.HasKeyboardFocus){$editor.SetFocus()}
 $deadline=[DateTime]::UtcNow.AddSeconds(3)
 do {
  Guard
  $editor=Editor
  if($editor.Current.HasKeyboardFocus){return}
  Start-Sleep -Milliseconds 50
 } while([DateTime]::UtcNow -lt $deadline)
 throw 'Editor did not acquire observed provider focus'
}
function Expect-Text([string]$expected,[string]$stage) {
 $deadline=[DateTime]::UtcNow.AddSeconds(5);$actual=$null
 do {
  Guard
  $actual=Record-Element (Editor)
  if($actual.text -ceq $expected){Record $stage $actual;return}
  Start-Sleep -Milliseconds 50
 } while([DateTime]::UtcNow -lt $deadline)
 Record $stage ([ordered]@{expected=$expected;actual=$actual})
 Record 'text mismatch controls' (Snapshot)
 if('JourneyFrame' -as [type]) {
  Guard;$frame=[JourneyFrame]::Capture($script:window);$capture=Join-Path $script:scratch 'text-mismatch.png'
  try{$frame.Save($capture)}finally{$frame.Dispose()};$script:extraArtifacts.Add($capture)
 }
 throw "Exact text mismatch: $stage"
}
function Expect-Dirty([bool]$dirty,[string]$stage) {
 $deadline=[DateTime]::UtcNow.AddSeconds(5);$tabs=@()
 do {
  Guard
  $tabs=@(Elements | Where-Object {$_.Current.ControlType -eq [System.Windows.Automation.ControlType]::TabItem} | ForEach-Object {
   @{name=$_.Current.Name;selected=$_.GetCurrentPropertyValue([System.Windows.Automation.SelectionItemPattern]::IsSelectedProperty)}
  })
  $active=@($tabs | Where-Object {$_.selected -eq $true})
  if($active.Count -eq 1 -and ($active[0].name.EndsWith(', modified') -eq $dirty)){Record $stage @{tabs=$tabs;dirty=$dirty};return}
  Start-Sleep -Milliseconds 50
 } while([DateTime]::UtcNow -lt $deadline)
 Record $stage @{tabs=$tabs;expected_dirty=$dirty}
 throw "Dirty tab state mismatch: $stage"
}
function Expect-File([string]$path,[byte[]]$expected,[string]$stage) {
 $deadline=[DateTime]::UtcNow.AddSeconds(5);$bytes=$null;$readError=$null
 do {
  if([IO.File]::Exists($path)) {
   try {
    $stream=[IO.File]::Open($path,[IO.FileMode]::Open,[IO.FileAccess]::Read,([IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete))
    $reader=[IO.BinaryReader]::new($stream)
    try {$bytes=$reader.ReadBytes(65537)} finally {$reader.Dispose();$stream.Dispose()}
    if($bytes.Length -gt 65536){throw 'Saved plain-text fixture exceeded 65536 bytes'}
    if([Convert]::ToBase64String($bytes) -ceq [Convert]::ToBase64String($expected)) {
     Record $stage @{path=$path;bytes=$bytes.Length;sha256=(Hash-File $path);base64=[Convert]::ToBase64String($bytes)};return
    }
   } catch {
    if($_.Exception.GetBaseException() -isnot [IO.IOException]){throw}
    $readError=$_.Exception.Message
   }
  }
  Start-Sleep -Milliseconds 50
 } while([DateTime]::UtcNow -lt $deadline)
 Record $stage @{path=$path;read_error=$readError;expected_base64=[Convert]::ToBase64String($expected);actual_base64=$(if($null -ne $bytes){[Convert]::ToBase64String($bytes)}else{$null})}
 throw "Exact saved bytes mismatch: $stage"
}
function File-Dialog([string]$path,[bool]$folder=$false) {
 $full=[IO.Path]::GetFullPath($path)
 $owned=[IO.Path]::GetFullPath($script:scratch)+[IO.Path]::DirectorySeparatorChar
 if(-not $full.StartsWith($owned,[StringComparison]::OrdinalIgnoreCase)){throw 'File dialog target escapes scratch'}
 if($folder -and -not [IO.Directory]::Exists($full)){throw 'Folder dialog requires an existing owned directory'}
 $deadline=[DateTime]::UtcNow.AddSeconds(8);$dialog=[IntPtr]::Zero
 do {
  [JourneyInput]::Desktop()
  $foreground=[JourneyInput]::GetForegroundWindow()
  if($foreground -ne $script:window -and [JourneyInput]::Owner($foreground) -eq $script:process.Id){$dialog=$foreground;break}
  if($foreground -ne $script:window){throw 'Foreground left owned editor while waiting for file dialog'}
  Start-Sleep -Milliseconds 50
 } while([DateTime]::UtcNow -lt $deadline)
 if($dialog -eq [IntPtr]::Zero){throw 'Native file dialog did not appear'}
 Guard $dialog
 $deadline=[DateTime]::UtcNow.AddSeconds(5);$fields=$null
 do {
  Guard $dialog
  $dialogElements=@(Elements $dialog)
  $hosts=@($dialogElements | Where-Object {$_.Current.AutomationId -eq 'FileNameControlHost'})
  if($hosts.Count -eq 1) {
   $descendants=$hosts[0].FindAll([System.Windows.Automation.TreeScope]::Descendants,[System.Windows.Automation.Condition]::TrueCondition)
   if($descendants.Count -gt 32){throw 'Native file field subtree exceeded 32 nodes'}
   $fields=@($descendants | Where-Object {[JourneyInput]::ClassName([IntPtr]$_.Current.NativeWindowHandle) -eq 'Edit'})
   if($fields.Count -eq 1){break}
  } elseif($hosts.Count -eq 0) {
   # The existing Open route exposes the standard legacy filename combo (1148),
   # unlike Save As's FileNameControlHost. Select only its real Edit HWND.
   $fieldLabel=if($folder){'Folder:'}else{'File name:'}
   $fieldId=if($folder){'1152'}else{'1148'}
   $labels=@($dialogElements | Where-Object {$_.Current.AutomationId -eq '1090' -and $_.Current.Name -ceq $fieldLabel})
   if($labels.Count -eq 1) {
    $fields=@($dialogElements | Where-Object {$_.Current.AutomationId -eq $fieldId -and [JourneyInput]::ClassName([IntPtr]$_.Current.NativeWindowHandle) -eq 'Edit'})
    if($fields.Count -eq 1){break}
   }
  }
  Start-Sleep -Milliseconds 50
 } while([DateTime]::UtcNow -lt $deadline)
 if($hosts.Count -gt 1 -or $null -eq $fields -or $fields.Count -ne 1){
  Record 'file field discovery failure' (Snapshot $dialog)
  throw 'Native File name field missing/ambiguous after bounded discovery'
 }
 $field=$fields[0];$fieldWindow=[IntPtr]$field.Current.NativeWindowHandle
 Guard $dialog
 [JourneyInput]::FileField($dialog,$fieldWindow);Start-Sleep -Milliseconds 150
 if([JourneyInput]::FocusState($dialog).focus -ne $fieldWindow){throw 'Native File name field lacks observed focus'}
 Record 'native file dialog' @{dialog=$dialog.ToInt64();field=(Record-Element $field);native_field=$fieldWindow.ToInt64();native_focus=[JourneyInput]::FocusState($dialog).focus.ToInt64()}
 [JourneyInput]::Key($dialog,65,$true,$false)
 [JourneyInput]::Text($dialog,$full)
 $observed=@{text=[JourneyInput]::FieldText($fieldWindow);native_field=$fieldWindow.ToInt64();process_id=[JourneyInput]::Owner($fieldWindow);native_focus=[JourneyInput]::FocusState($dialog).focus.ToInt64()}
 Record 'native file path input' $observed
 if($observed.text -cne $full){throw 'Native File name input mismatch'}
 if($folder) {
  # Enter in this folder-name edit navigates instead of confirming selection.
  # Activate the observed native Select Folder button exactly once.
  $buttons=@(Elements $dialog | Where-Object {$_.Current.AutomationId -eq '1' -and $_.Current.Name -ceq 'Select Folder' -and $_.Current.IsEnabled})
  if($buttons.Count -ne 1){throw 'Native Select Folder button missing or ambiguous'}
  $button=[IntPtr]$buttons[0].Current.NativeWindowHandle
  Guard $dialog;Record 'native folder selection' (Record-Element $buttons[0])
  [JourneyInput]::DialogButton($dialog,$button)
 } else {[JourneyInput]::Key($dialog,13,$false,$false)}
 $deadline=[DateTime]::UtcNow.AddSeconds(8)
 do {
  [JourneyInput]::Desktop()
  if([JourneyInput]::GetForegroundWindow() -eq $script:window){Focus-Editor;return}
  if([JourneyInput]::Owner([JourneyInput]::GetForegroundWindow()) -ne $script:process.Id){throw 'Foreground left owned file dialog'}
  Start-Sleep -Milliseconds 50
 } while([DateTime]::UtcNow -lt $deadline)
 Record 'file dialog did not dismiss' (Snapshot $dialog)
 throw 'File dialog did not dismiss after one submission'
}
function Step([string]$id,[string]$observation,[scriptblock]$action) {
 if($script:failed){$script:steps.Add(@{id=$id;status='NOT_RUN';observed='Prerequisite step failed; no dependent action submitted.'});return}
