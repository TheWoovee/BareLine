 public static void DialogButton(IntPtr dialog,IntPtr button) {
  Guard(dialog);
  if(!IsChild(dialog,button) || Owner(dialog)!=Owner(button) || ClassName(button)!="Button")
   throw new Exception("Native dialog button identity mismatch");
  if(!PostMessageW(button,0xF5,UIntPtr.Zero,IntPtr.Zero))throw new Exception("Native dialog button submission failed");
