  Guard(window);
  // Select an already installed English layout on the owned editor thread only.
  // Do not install layouts or change the user's default/global keyboard settings.
  var layouts=new IntPtr[64];int count=GetKeyboardLayoutList(layouts.Length,layouts);IntPtr chosen=IntPtr.Zero;
  if(count<=0 || count>64)throw new Exception("Keyboard layout inventory unavailable");
