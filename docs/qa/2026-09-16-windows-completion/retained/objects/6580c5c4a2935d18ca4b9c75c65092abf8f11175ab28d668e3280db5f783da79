[package]
name = "bareline-platform-windows"
version.workspace = true
edition.workspace = true
license.workspace = true
rust-version.workspace = true

[features]
qa-inventory = []
offscreen = ["windows/Win32_Graphics_Imaging"]
fixture-release = []

[dependencies]
bareline-unicode-fold = { path = "../unicode-fold" }
unicode-segmentation = "=1.13.3"
bareline-distribution = { path = "../distribution" }
sha2 = "=0.10.9"
bareline-platform = { path = "../platform" }
bareline-extensions-protocol = { path = "../extensions-protocol" }
bareline-commands = { path = "../commands" }
bareline-macros = { path = "../macros" }
bareline-renderer = { path = "../renderer" }

[target.'cfg(windows)'.dependencies]
windows-core = "=0.62.2"
windows = { workspace = true, features = ["Win32_System_LibraryLoader", "Win32_System_Environment", "Win32_Storage_Xps", "Win32_UI_Controls_Dialogs", "Win32_UI_HiDpi", "Win32_System_Ole", "Win32_UI_Accessibility", "Win32_System_RemoteDesktop", "Win32_System_Pipes", "Win32_Security_Authorization", "Win32_Security_Cryptography", "Win32_Foundation", "Win32_Graphics_Direct2D", "Win32_Graphics_Direct2D_Common", "Win32_Graphics_DirectWrite", "Win32_Graphics_Dxgi_Common", "Win32_Graphics_Dxgi", "Win32_Graphics_Direct3D", "Win32_Graphics_Direct3D11", "Win32_Graphics_Gdi", "Win32_UI_WindowsAndMessaging", "Win32_UI_Shell", "Win32_UI_Shell_Common", "Win32_System_Com", "Win32_System_IO", "Win32_Security", "Win32_UI_Controls", "Win32_System_ProcessStatus", "Win32_System_Threading", "Win32_System_JobObjects", "Win32_System_StationsAndDesktops", "Win32_System_Diagnostics_ToolHelp", "Win32_Graphics_Dwm", "Win32_Storage_FileSystem", "Win32_System_DataExchange", "Win32_System_Memory", "Win32_Networking_WinHttp", "Win32_Security_WinTrust", "Win32_Security_Cryptography_Catalog", "Win32_Security_Cryptography_Sip"] }

windows-numerics = "=0.3.1"

[dev-dependencies]
bareline-editor-surface = { path = "../editor-surface" }
bareline-file-io = { path = "../file-io" }
bareline-document = { path = "../document" }




[target.'cfg(windows)'.dependencies.accesskit]
version = '=0.25.0'

[target.'cfg(windows)'.dependencies.accesskit_windows]
version = '=0.35.0'




