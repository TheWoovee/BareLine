"""Materialize complete acceptance/command work definitions; never manufactures results."""
import argparse
import hashlib
import json
from pathlib import Path
import re

ROOT=Path(__file__).resolve().parents[2]
COVERAGE=ROOT/'docs/implementation/production-readiness/COVERAGE.md'

FAMILIES = {
    'app':'Launch a generated clean profile, with separate clean and dirty documents for shutdown.',
    'file':'Use owned existing, missing, read-only, changed-on-disk and unsaved files. Use a disposable VM for associations, installer and update actions.',
    'edit':'Use ASCII, combining marks, emoji, invalid-byte spans, empty/nonempty selections and a read-only counterpart. Keep exact before/after bytes and Undo state.',
    'editor':'Use generated multiline rows with tabs, CJK, short lines, multi-selections and a read-only counterpart. Preserve selection offsets and transaction/Undo boundaries.',
    'search':'Use generated positive, absent, multiline, invalid-pattern and stale-revision fixtures. Retain query/options, complete/partial state and exact global ranges.',
    'workspace':'Use a generated root with ordinary files, inaccessible entries and an owned link cycle. Retain tree identities and before/after bytes for mutations.',
    'view':'Use two generated documents and cloned/split panes. Retain active pane, logical caret/scroll/fold state and exact document bytes.',
    'views':'Use two generated documents and cloned/split panes. Retain active pane, logical caret/scroll/fold state and exact document bytes.',
    'language':'Use the selected language, a provider-absent fixture, valid/malformed definitions and stale revisions. Retain provider identity, visible result and unchanged bytes on rejection.',
    'settings':'Use only an isolated profile and generated workspace settings; retain validated TOML, effective values, restart behavior and rejected privileged overrides.',
    'extensions':'Use reviewed signed packages, authority/rotation/revocation vectors and an owned runtime/host. Retain identity, grants, process lifecycle and rejection before execution.',
    'macro':'Use an owned recording with literal text, explicit search arguments and a failing event. Retain recorded IDs, replay bytes and resume location.',
    'run':'Use only the owned external_fixture.py process tree with literal arguments and bounded output. Retain consent, argv/cwd, output navigation and observed descendant cleanup.',
    'compare':'Use two exact generated byte sequences including Unicode, ignores, stale revisions and bounded coarse output. Retain hunks, selected target and Undo bytes.',
    'encoding':'Use BOM, mixed EOL, invalid-byte and legacy fixtures. Retain original bytes, codec/provenance, conversion policy and refused destructive saves.',
}


def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()


def definitions(inventory, historical=False):
    document=json.loads(inventory.read_text(encoding='utf-8-sig'))
    if document.get('schema_version') != 2 or not isinstance(document.get('commands'),list):raise ValueError('A composed runtime inventory is required')
    commands=document['commands']
    if not commands or len(commands)>10000 or len(set(commands))!=len(commands) or any(not isinstance(c,str) or not re.fullmatch(r'[A-Za-z0-9_.:-]{1,200}',c) for c in commands):raise ValueError('Invalid command identities')
    acceptance=[];minimum=[]
    for kind,key,criterion in re.findall(r'\*\*((AC|MV)-\d{3}-\d{2}):\*\* ([^\r\n]+)',COVERAGE.read_text(encoding='utf-8-sig')):
        row=dict(id=kind,owner='QUAL-'+kind.split('-')[1],criterion=criterion,
                 setup='Pin the candidate/source, exact OS/build, hardware, mode, DPI/theme and all generated fixtures. Use only owned scratch data; fault injection and installation require a disposable machine.',
                 actions=[clause.strip() for clause in criterion.split(';')],
                 evidence_required=['Exact input/fixture hashes','Actual observations for every clause, including rejected and cancelled paths','Process result and bounded cleanup','Retained raw artifacts and independent mapping review'],
                 status='NOT_RUN',review='pending',complete_case_mapping=False)
        (acceptance if key=='AC' else minimum).append(row)
    if len(acceptance)!=81 or len(minimum)!=199:raise ValueError('Authority counts changed; review the complete definition set')
    if len({r['id'] for r in acceptance+minimum})!=280:raise ValueError('Duplicate acceptance/scenario definitions')
    outcomes=[]
    for command in sorted(commands):
        family=command.split('.')[0]
        setup=FAMILIES.get(family,'Open the exact contributed command surface in an isolated fixture, capture its documented prerequisites and expected state transition before execution.')
        for outcome in ('success','disabled','failure'):
            action={
                'success':'Satisfy the documented prerequisites, invoke this exact ID once through its user-facing route, and compare the observed effect to its command contract. For edits, check target bytes, selection, dirty state and Undo; for toggles/panels, check state and focus; for external work, check the owned output and cleanup.',
                'disabled':'Remove one required prerequisite, capture the specific unavailable reason, and attempt the registered route. Confirm that no document, profile or external resource changed.',
                'failure':'Inject the documented recoverable failure in the owned fixture, invoke this exact ID once, and retain the error, unchanged protected data, absence of partial commits and recovery/retry behavior.'}[outcome]
            outcomes.append(dict(id=f'command:{command}:{outcome}',command=command,outcome=outcome,owner='DEV-004',setup=setup,
                                 action=action,oracle_binding='Requires a reviewed command-specific before/after oracle or reasoned inapplicability with source authority. A label or handler count is insufficient.',
                                 status='NOT_RUN',review='pending',complete_case_mapping=False))
    return dict(schema_version=1,kind='qualification_work_definitions',planning_only=True,release_approved=False,
                inventory=dict(path=str(inventory.resolve()),sha256=sha(inventory),commit=document.get('commit'),binary_sha256=document.get('binary_sha256'),historical=historical),
                authority=dict(path=str(COVERAGE.relative_to(ROOT)),sha256=sha(COVERAGE)),
                acceptance=acceptance,minimum_scenarios=minimum,command_outcomes=outcomes,
                completion_policy='Definitions are work to execute, not evidence. All clauses and command-specific oracles require review. No PASS/exclusion is inferred. Rebuild from the final configured composed runtime inventory, including trusted extension contributions.')


if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--inventory',type=Path,required=True);parser.add_argument('--output',type=Path,required=True)
    parser.add_argument('--historical',action='store_true')
    args=parser.parse_args();result=definitions(args.inventory,args.historical)
    with args.output.open('x',encoding='utf-8') as stream:json.dump(result,stream,indent=2,ensure_ascii=False);stream.write('\n')
    print(json.dumps(dict(acceptance=len(result['acceptance']),minimum_scenarios=len(result['minimum_scenarios']),command_outcomes=len(result['command_outcomes']),planning_only=True)))
