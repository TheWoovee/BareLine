[package]
name = "bareline-distribution"
version.workspace = true
edition.workspace = true
license.workspace = true
rust-version.workspace = true

[dependencies]
lexopt = "=0.3.1"
minisign-verify = "=0.2.4"
base64 = "=0.22.1"
sha2 = "=0.10.9"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
quick-xml = { version = "=0.41.0", default-features = false }

[dev-dependencies]
bareline-platform = { path = "../platform" }
bareline-extensions-protocol = { path = "../extensions-protocol" }
