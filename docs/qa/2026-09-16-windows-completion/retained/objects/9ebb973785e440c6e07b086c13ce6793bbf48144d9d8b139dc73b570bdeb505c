    power::{Limits, PowerEdit, SelectionSet},
};
use bareline_renderer::{DrawOp, Point, Rect};
use bareline_syntax::{Cancellation, Language};
use bareline_ui::{
    controls::{ControlAction, ControlState, Key, UiEvent},
    rect, text,
