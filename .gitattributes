# Signed regression fixtures must retain their original bytes.
# Line-ending conversion would invalidate detached signatures.
crates/distribution/tests/fixtures/authority/** -text
# Upstream license supplements carry hashes of the original downloaded bytes.
packaging/windows/license-overrides/cranelift*/** -text
packaging/windows/license-overrides/pulley*/** -text
packaging/windows/license-overrides/wasmtime*/** -text
# Fuzz seed corpora are raw bytes; line-ending conversion would change the inputs.
fuzz/corpus/** -text
packaging/windows/native-licenses/*/LICEN* -text
vendor/accesskit_windows-0.35.0/AUTHORS -text
vendor/accesskit_windows-0.35.0/LICENSE* -text
# The bundled font and raster goldens are compared byte for byte.
crates/renderer-soft/fonts/*.ttf -text
crates/renderer-soft/tests/golden/** -text
