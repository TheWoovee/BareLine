{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bareline native regression journey manifest",
  "type": "object",
  "required": [
    "schema_version",
    "journeys"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "journeys": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "timeout_seconds",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "id",
                "action",
                "expected"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
