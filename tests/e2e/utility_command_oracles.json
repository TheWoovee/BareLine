{
  "schema_version": 1,
  "kind": "command_oracle_fixtures",
  "scope": "Utility conversion regression vectors shared with the Rust core tests.",
  "commands": [
    {
      "command": "utilities.base64Encode",
      "core_test": "utilities::command_oracle_tests::base64_encode_contract",
      "success": [
        {
          "id": "document",
          "before": "Hello 🙂",
          "range": [
            0,
            10
          ],
          "after": "SGVsbG8g8J+Zgg==",
          "max_bytes": 16
        },
        {
          "id": "unicode-selection",
          "before": "前|Hello 🙂|後",
          "range": [
            4,
            14
          ],
          "after": "前|SGVsbG8g8J+Zgg==|後",
          "max_bytes": 16
        }
      ],
      "failures": [
        {
          "id": "cancel-before-staging",
          "before": "Hello 🙂",
          "range": [
            0,
            10
          ],
          "max_bytes": 1024,
          "error": "Cancelled",
          "cancelled": true
        },
        {
          "id": "expanded-output-over-budget",
          "before": "abcdef",
          "range": [
            0,
            6
          ],
          "max_bytes": 7,
          "error": "BudgetExceeded"
        }
      ]
    },
    {
      "command": "utilities.base64Decode",
      "core_test": "utilities::command_oracle_tests::base64_decode_contract",
      "success": [
        {
          "id": "document",
          "before": "SGVsbG8g8J+Zgg==",
          "range": [
            0,
            16
          ],
          "after": "Hello 🙂",
          "max_bytes": 16
        },
        {
          "id": "unicode-selection",
          "before": "前|SGVsbG8g8J+Zgg==|後",
          "range": [
            4,
            20
          ],
          "after": "前|Hello 🙂|後",
          "max_bytes": 16
        }
      ],
      "failures": [
        {
          "id": "cancel-before-staging",
          "before": "SGVsbG8g8J+Zgg==",
          "range": [
            0,
            16
          ],
          "max_bytes": 1024,
          "error": "Cancelled",
          "cancelled": true
        },
        {
          "id": "invalid-syntax-1",
          "before": "前|not base64!|後",
          "range": [
            4,
            15
          ],
          "max_bytes": 1024,
          "error": "InvalidDecode"
        },
        {
          "id": "invalid-syntax-2",
          "before": "前|SGVsbG8===|後",
          "range": [
            4,
            14
          ],
          "max_bytes": 1024,
          "error": "InvalidDecode"
        },
        {
          "id": "decoded-invalid-utf8",
          "before": "/w==",
          "range": [
            0,
            4
          ],
          "max_bytes": 1024,
          "error": "InvalidUtf8"
        },
        {
          "id": "input-over-budget",
          "before": "SGVsbG8g8J+Zgg==",
          "range": [
            0,
            16
          ],
          "max_bytes": 15,
          "error": "BudgetExceeded"
        }
      ]
    },
    {
      "command": "utilities.urlEncode",
      "core_test": "utilities::command_oracle_tests::url_encode_contract",
      "success": [
